{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(//**)",
      "Bash(pnpm install)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm test:concurrency)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm build)",
      "Bash(pnpm sync:agents)",
      "Bash(pnpm check:agents)",
      "Bash(pnpm check:no-delete)",
      "Bash(pnpm --filter * *)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": []
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SCRIPT=\"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh\"; [ -f \"$SCRIPT\" ] && bash \"$SCRIPT\" || true"
          }
        ]
      }
    ]
  }
}
