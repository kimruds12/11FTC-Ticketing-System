# ---------------------------------------------------------------------------
# 11FTC Ticketing — example environment. Copy to .env and fill in real values.
# NEVER commit a real secret. .env is gitignored; this file must stay example-only.
# ---------------------------------------------------------------------------

NODE_ENV=development

# ===========================================================================
# SUPABASE — self-hosted, on the company network (see docs/deployment.md).
#
# The values below come from the Supabase stack's own `docker/.env`:
#   ANON_KEY, SERVICE_ROLE_KEY, POSTGRES_PASSWORD, KONG_HTTP_PORT.
# Auth must be running with ASYMMETRIC signing (JWT_KEYS / ES256). With legacy
# HS256 the JWKS endpoint serves no usable key and this API rejects every token.
#
# `<host>` is localhost while testing on the server itself, and the LAN hostname
# once other machines connect. Change every occurrence together: SUPABASE_URL
# also determines the token ISSUER, so a mismatch fails verification silently.
# ===========================================================================

# --- Database (SESSION pooling on 5432) ---
#
#   postgres://postgres.<POOLER_TENANT_ID>:<POSTGRES_PASSWORD>@<host>:5432/postgres
#              \_______/ \_______________/                     \____/
#                 user         TENANT                            host
#
# THE TENANT GOES IN THE USERNAME, not the host. Port 5432 is Supavisor, not
# Postgres — `db` publishes no host port, so the pooler is the only way in.
# Supavisor is multi-tenant and the Postgres wire protocol has no field for
# "which tenant", so it reads it from the username after the dot. This is the
# same shape Supabase cloud uses (`postgres.<project-ref>`). Plain `postgres`
# fails with: no tenant identifier provided (external_id or sni_hostname required).
#
# PORT 5432, NOT 6543. 5432 is session pooling; 6543 is transaction pooling,
# which cannot hold the multi-statement transactions TicketService depends on
# (FR-31). That failure appears only under concurrency, not on first use.
# supabase-js is intentionally NOT used — PostgREST cannot run them at all.
DATABASE_URL=postgres://postgres.<POOLER_TENANT_ID>:<POSTGRES_PASSWORD>@<host>:5432/postgres

# The SAME database, addressed from INSIDE a container. Identical but for the
# host, because `localhost` in a container is that container — not the machine.
#
# Needed ONLY while Supabase runs in a separate compose project on the same
# machine (local development). docker-compose.yml maps this onto DATABASE_URL
# for its services, while the value above stays `localhost` for host-side
# tooling: pnpm db:migrate, scripts/seed-admin.mjs, pnpm import:sheet.
#
# ON THE DEPLOYMENT SERVER, LEAVE THIS UNSET. A real LAN hostname resolves
# identically from the browser, the host and the containers, so one URL serves
# everything and this split disappears.
DATABASE_URL_INTERNAL=

# --- Supabase Auth (JWT verified locally via JWKS; no per-request round trip) ---
SUPABASE_URL=http://<host>:8000
SUPABASE_JWKS_URL=http://<host>:8000/auth/v1/.well-known/jwks.json
# The SAME Supabase, addressed from INSIDE a container — the sibling of
# DATABASE_URL_INTERNAL above, and needed for the same reason: `localhost` in a
# container is that container. When set, docker-compose maps it onto the api and
# web services; the server-side auth clients dial it while the BROWSER keeps
# using NEXT_PUBLIC_SUPABASE_URL.
#
# SUPABASE_URL above is deliberately NOT overridden by it: that one defines the
# expected token ISSUER and must keep matching what GoTrue stamps in. Only the
# dialled address changes.
#
# ON THE DEPLOYMENT SERVER, LEAVE THIS UNSET — one LAN hostname resolves from
# everywhere and the split disappears.
SUPABASE_INTERNAL_URL=

# service_role key stays on the backend ONLY. Never ship it to the web app.
# Required: account provisioning calls GoTrue's admin API with it (ADR-0018).
SUPABASE_SERVICE_ROLE_KEY=

# --- Redis (BullMQ triggers only — no response caching yet) ---
REDIS_URL=redis://localhost:6379

# --- Google Sheets sync (M8 worker) ---
GOOGLE_SHEETS_SPREADSHEET_ID=
# The TAB NAME the worker writes into — not a tab index, not a gid. New tickets are inserted
# at the TOP of this tab so the team's newest-first ordering is preserved (ADR-0016).
GOOGLE_SHEETS_TAB=Tickets
# Deprecated alias for GOOGLE_SHEETS_TAB, kept so existing .env files keep working.
# GOOGLE_SHEETS_RAW_TAB=
# Prefer Workload Identity Federation in prod. For local dev, a service-account
# JSON key file path — the file itself is gitignored and never committed.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.local.json

# --- Ticket numbering scope (OPEN-1 — confirm against the real sheet before go-live) ---
# 'date'  -> scope_key '2026-07-15', ticket_no IT-2026-0715-001
# 'year'  -> scope_key '2026',       ticket_no IT-2026-0174
TICKET_NUMBER_SCOPE=year

# --- API / Web wiring ---
API_PORT=3001
WEB_PORT=3000
# Browser origins allowed to call the API (comma-separated). Server Components reach the API
# server-to-server and ignore CORS, but ANYTHING the browser fetches — the dashboard's live
# analytics, the employee/technician pickers — is blocked without this, silently: the request
# never reaches the API, so nothing appears in its log and the page just renders empty.
# Never `*`; these routes take a bearer token.
CORS_ORIGINS=http://localhost:3000
# Include the /api/v1 prefix — the API is URI-versioned (ADR-0012); the web Axios services
# call clean paths like /me against this base.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Server-side (RSC / Server Actions) base URL. Leave UNSET when running on the host — it
# falls back to NEXT_PUBLIC_API_URL. Docker Compose sets it to http://api:3001/api/v1,
# because inside the web container `localhost:3001` is the web app, not the api.
# API_INTERNAL_URL=
# Reached by the BROWSER, so `<host>` must be a name every client machine can resolve —
# `localhost` works only on the server itself.
NEXT_PUBLIC_SUPABASE_URL=http://<host>:8000
# The ANON key (never service_role): this one is inlined into the client bundle.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
