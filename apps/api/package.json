{
  "name": "@11ftc/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "NestJS API + BullMQ sync worker. The transaction boundary.",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile main.worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/main.worker.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "test:concurrency": "vitest run --config vitest.concurrency.config.ts",
    "import:sheet": "nest start --entryFile main.import --"
  },
  "dependencies": {
    "@11ftc/db": "workspace:*",
    "@11ftc/shared": "workspace:*",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/swagger": "^11.4.5",
    "bullmq": "^5.80.3",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^10.9.0",
    "googleapis": "^173.0.0",
    "jose": "^6.2.3",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/node": "^20.19.0",
    "@types/pg": "^8.15.0",
    "eslint": "^9.9.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
