# --- actor associations ---
employee -> staff: "reports IT concern" {style.stroke-dash: 3}

staff -> sys.ticketing.encode
staff -> sys.ticketing.update
staff -> sys.ticketing.assign
staff -> sys.ticketing.ongoing
staff -> sys.ticketing.search
staff -> sys.ticketing.history
staff -> sys.ticketing.close
