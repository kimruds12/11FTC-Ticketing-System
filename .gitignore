# dependencies
node_modules/
.pnpm-store/

# builds
dist/
build/
.next/
out/
*.tsbuildinfo

# turbo
.turbo/

# env & secrets — NEVER commit real values
.env
# EVERY .env variant, so a backup taken while switching environments
# (.env.cloud.bak, .env.selfhosted, .env.prod) cannot be committed by a stray `git add -A`.
# .env.example is the one exception — it holds names and comments, never values.
.env.*
!.env.example
*.pem
service-account*.json
gcp-*.json
# raw pasted secret / env dumps — never commit
*ENV.txt
*.env.txt
secrets/

# test / coverage
coverage/
.nyc_output/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# agent local/personal settings — committed team settings live in .claude/settings.json
**/.claude/settings.local.json

# google application credentials
/google_application_credentials

# Legacy spreadsheet exports for the M10 import. These hold real employee names and
# ticket content — keep them local. The import runs from a file you supply, never from
# a committed copy.
/docs/11FTC-TICKET-SHEET/
*.xlsx
*.xls
!docs/**/*template*.xlsx