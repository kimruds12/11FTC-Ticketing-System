{
  "root": true,
  "env": {
    "node": true,
    "es2022": true
  },
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "extends": [
    "eslint:recommended"
  ],
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    ".next/",
    "coverage/"
  ],
  "rules": {
    "no-console": "warn",
    "no-unused-vars": "off"
  }
}
