// ============================================================
// 11FTC Ticketing Management System — Prisma Schema
// ============================================================
// Authoritative source: documents/11FTC_SRS_Rev3.md (rev 4)
// All entities, fields, and constraints below correspond to
// SRS §5 through §9A.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// SRS §6A — Department
// ============================================================
model Department {
  departmentId String    @id @default(uuid()) @map("department_id") @db.Uuid
  name         String    @unique
  isActive     Boolean   @default(true) @map("is_active")
  employees    Employee[]

  @@map("departments")
}

// ============================================================
// SRS §6B — MainIssueCategory
// ============================================================
model MainIssueCategory {
  mainIssueId String   @id @default(uuid()) @map("main_issue_id") @db.Uuid
  label       String   @unique
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  tickets     Ticket[]

  @@map("main_issue_categories")
}

// ============================================================
// SRS §6C — User (IT Administrator or IT Staff)
// ============================================================
model User {
  userId        String    @id @default(uuid()) @map("user_id") @db.Uuid
  email         String    @unique
  passwordHash  String    @map("password_hash")
  fullName      String    @map("full_name")
  role          UserRole
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  assignedTickets Ticket[]   @relation("AssignedTo")
  createdTickets  Ticket[]   @relation("CreatedBy")
  auditEntries    AuditLog[]

  @@map("users")
}

// ============================================================
// SRS §6 — Employee
// ============================================================
model Employee {
  employeeId     String    @id @default(uuid()) @map("employee_id") @db.Uuid
  name           String
  nameNormalized String    @unique @map("name_normalized")
  departmentId   String    @map("department_id") @db.Uuid
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  department Department @relation(fields: [departmentId], references: [departmentId])
  tickets    Ticket[]

  @@map("employees")
}

// ============================================================
// SRS §5 — Ticket
// ============================================================
model Ticket {
  ticketId       String       @id @default(uuid()) @map("ticket_id") @db.Uuid
  ticketNo       String       @unique @map("ticket_no")
  date           DateTime     @db.Date
  sequenceScope  String       @map("sequence_scope")
  sequenceNumber Int          @map("sequence_number")
  employeeId     String       @map("employee_id") @db.Uuid
  mainIssueId    String       @map("main_issue_id") @db.Uuid
  concern        String       @db.Text
  assignedTo     String?      @map("assigned_to") @db.Uuid
  createdBy      String       @map("created_by") @db.Uuid
  status         TicketStatus @default(Closed)
  remarks        String?      @db.Text
  ongoingAt      DateTime?    @map("ongoing_at")
  closedAt       DateTime?    @map("closed_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  // Relations
  employee     Employee          @relation(fields: [employeeId], references: [employeeId])
  mainIssue    MainIssueCategory @relation(fields: [mainIssueId], references: [mainIssueId])
  assignedUser User?             @relation("AssignedTo", fields: [assignedTo], references: [userId])
  creator      User              @relation("CreatedBy", fields: [createdBy], references: [userId])
  auditLogs    AuditLog[]
  syncOutbox   SyncOutbox[]

  // Constraints
  @@unique([sequenceScope, sequenceNumber], name: "uq_ticket_seq")

  // Indexes per SRS §10
  @@index([date])
  @@index([status])
  @@index([assignedTo, status])
  @@index([closedAt])
  @@index([ongoingAt])

  @@map("tickets")
}

// ============================================================
// SRS §7 — Audit Log
// ============================================================
model AuditLog {
  auditLogId    String      @id @default(uuid()) @map("audit_log_id") @db.Uuid
  ticketId      String      @map("ticket_id") @db.Uuid
  action        AuditAction
  fieldName     String?     @map("field_name")
  previousValue String?     @map("previous_value") @db.Text
  newValue      String?     @map("new_value") @db.Text
  updatedBy     String      @map("updated_by") @db.Uuid
  updatedAt     DateTime    @default(now()) @map("updated_at")

  // Relations
  ticket Ticket @relation(fields: [ticketId], references: [ticketId])
  user   User   @relation(fields: [updatedBy], references: [userId])

  @@map("audit_logs")
}

// ============================================================
// SRS §9 — Ticket Sequence
// ============================================================
model TicketSequence {
  scopeKey     String   @id @map("scope_key")
  lastSequence Int      @map("last_sequence")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("ticket_sequences")
}

// ============================================================
// SRS §9A — Sync Outbox
// ============================================================
model SyncOutbox {
  outboxId     String        @id @default(uuid()) @map("outbox_id") @db.Uuid
  ticketId     String        @map("ticket_id") @db.Uuid
  operation    SyncOperation @default(UPSERT)
  rowKey       String        @map("row_key")
  payload      Json
  status       SyncStatus    @default(PENDING)
  attempts     Int           @default(0)
  rawRowNumber Int?          @map("raw_row_number")
  lastError    String?       @map("last_error") @db.Text
  createdAt    DateTime      @default(now()) @map("created_at")
  sentAt       DateTime?     @map("sent_at")

  // Relations
  ticket Ticket @relation(fields: [ticketId], references: [ticketId])

  // Indexes per SRS §10
  @@index([status, createdAt])

  @@map("sync_outbox")
}

// ============================================================
// Enums
// ============================================================

enum TicketStatus {
  Open
  Ongoing
  Closed
}

enum UserRole {
  IT_ADMINISTRATOR
  IT_STAFF
}

enum AuditAction {
  CREATE
  UPDATE
  ASSIGN
  STATUS_CHANGE
  CLOSE
}

enum SyncStatus {
  PENDING
  SENT
  FAILED
}

enum SyncOperation {
  UPSERT
}
